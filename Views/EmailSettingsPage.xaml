<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AidHopePlus.Views.EmailSettingsPage"
    Title="Email Settings"
    BackgroundColor="#F5F7F6">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="18"
            MaximumWidthRequest="500"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Label
                Text="Gmail Configuration"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#246B4A"
                HorizontalOptions="Center"/>

            <Label
                Text="Configure the Gmail account used to send AidHopePlus welcome emails."
                FontSize="14"
                TextColor="Gray"
                HorizontalTextAlignment="Center"/>

            <Label Text="Gmail Address" FontAttributes="Bold"/>

            <Entry
                x:Name="GmailAddressEntry"
                Placeholder="youraccount@gmail.com"
                Keyboard="Email"
                BackgroundColor="White"/>

            <Label Text="Gmail App Password" FontAttributes="Bold"/>

            <Entry
                x:Name="GmailPasswordEntry"
                Placeholder="Enter your 16-character app password"
                IsPassword="True"
                BackgroundColor="White"/>

            <Button
                Text="Save Email Settings"
                BackgroundColor="#246B4A"
                TextColor="White"
                HeightRequest="50"
                CornerRadius="8"
                Clicked="OnSaveClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
