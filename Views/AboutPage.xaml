<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AidHopePlus.Views.AboutPage"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="AIDS HOPE +"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#8B0000"
                   HorizontalOptions="Center"/>

            <Label Text="HIV/AIDS Support Awareness Management System"
                   FontSize="16"
                   TextColor="#8B0000"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10"/>

            <Label Text="About the System"
                   FontSize="20"
                   FontAttributes="Bold"/>

            <Label Text="AID HOPE + is a comprehensive management system designed to support organizations working with HIV/AIDS beneficiaries. It helps track beneficiaries, support sessions, awareness events, attendance and generate reports."
                   FontSize="15"
                   LineBreakMode="WordWrap"/>

            <Label Text="Key Features"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,15,0,0"/>

            <Label Text="• Beneficiary management&#10;• Support session tracking&#10;• Awareness events planning&#10;• Attendance records&#10;• Reports and dashboards&#10;• Works on Desktop and Mobile"
                   FontSize="15"/>

            <Label Text="Version 1.0.0  |  2026"
                   FontSize="13"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,30,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
