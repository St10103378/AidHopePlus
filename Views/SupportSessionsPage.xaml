<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AidHopePlus.Views.SupportSessionsPage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*" Padding="15" RowSpacing="12">

        <!-- Title + Add button: wraps under the title on very narrow screens -->
        <FlexLayout Wrap="Wrap"
                    JustifyContent="SpaceBetween"
                    AlignItems="Center">
            <Label Text="Support Sessions"
                   FontSize="26"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="0,0,10,5"/>
            <Button Text="Add Session"
                    BackgroundColor="#1a1a1a"
                    TextColor="White"
                    Margin="0,0,0,5"
                    Clicked="OnAddClicked"/>
        </FlexLayout>

        <SearchBar Grid.Row="1"
                   Placeholder="Search by name or support type..."
                   TextChanged="OnSearchTextChanged"/>

        <!-- Each session is a card instead of a 4-column table row -->
        <CollectionView Grid.Row="2" x:Name="SessionsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5"
                            Padding="12"
                            Stroke="LightGray"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="4">

                            <Label Text="{Binding Beneficiary.FullName}"
                                   FontAttributes="Bold"
                                   FontSize="16"/>

                            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
                                <Label Text="{Binding SupportType}"
                                       TextColor="#8B0000"/>
                                <Label Text="{Binding SessionDate, StringFormat='{0:yyyy-MM-dd}'}"
                                       TextColor="Gray"/>
                            </FlexLayout>

                            <Label Text="{Binding FollowUpNotes}"
                                   FontSize="13"
                                   TextColor="Gray"
                                   MaxLines="3"
                                   LineBreakMode="TailTruncation"/>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>