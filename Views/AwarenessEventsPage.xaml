<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AidHopePlus.Views.AwarenessEventsPage"
             Title="Awareness Events"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*" Padding="15" RowSpacing="12">

        <!-- Header: Create button wraps under the title on narrow screens -->
        <FlexLayout Wrap="Wrap"
                    JustifyContent="SpaceBetween"
                    AlignItems="Center">
            <Label Text="Awareness Events"
                   FontSize="26"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="0,0,10,5"/>
            <Button Text="Create Event"
                    BackgroundColor="#1a1a1a"
                    TextColor="White"
                    Margin="0,0,0,5"
                    Clicked="OnCreateClicked"/>
        </FlexLayout>

        <!-- Search -->
        <SearchBar Grid.Row="1"
                   Placeholder="Search events..."
                   TextChanged="OnSearchTextChanged"/>

        <!-- Each event is a card instead of a 4-column table row -->
        <CollectionView Grid.Row="2" x:Name="EventsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5"
                            Padding="12"
                            Stroke="LightGray"
                            StrokeThickness="1"
                            BackgroundColor="White">
                        <VerticalStackLayout Spacing="4">

                            <Label Text="{Binding EventName}"
                                   FontAttributes="Bold"
                                   FontSize="16"/>

                            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
                                <Label Text="{Binding Location}"
                                       TextColor="#8B0000"/>
                                <Label Text="{Binding EventDate, StringFormat='{0:yyyy-MM-dd}'}"
                                       TextColor="Gray"/>
                            </FlexLayout>

                            <FlexLayout Wrap="Wrap" Margin="0,4,0,0">
                                <Button Text="View"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        TextColor="#0066cc"
                                        Padding="8,0"
                                        Clicked="OnViewClicked"
                                        CommandParameter="{Binding .}"/>
                               
                                <Button Text="Delete"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        TextColor="#cc0000"
                                        Padding="8,0"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding .}"/>
                            </FlexLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>