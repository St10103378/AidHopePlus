<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AidHopePlus.Views.DashboardPage"
           
             BackgroundColor="White">

    <!-- The whole page scrolls inside the CollectionView, which avoids a
         scroll view nested inside another scroll view (bad on phones). -->
    <CollectionView x:Name="RecentSessionsList">

        <!-- ===== Everything above the list ===== -->
        <CollectionView.Header>
            <VerticalStackLayout Padding="15" Spacing="15">

                <Label Text="Dashboard"
                       FontSize="26"
                       FontAttributes="Bold"/>

                <Label x:Name="UsernameLabel"
       Text="Welcome!"
       FontSize="17"
       FontAttributes="Bold"
       TextColor="#8B0000"/>

                <!-- Stat cards: wrap onto new rows on narrow screens.
                     Basis=150 means about 2 per row on a phone, 5 in a row on desktop. -->
                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">

                    <Border FlexLayout.Basis="150" FlexLayout.Grow="1"
                            Margin="5" Padding="15"
                            Stroke="LightGray" StrokeThickness="1">
                        <VerticalStackLayout>
                            <Label Text="Total Beneficiaries" FontSize="12" TextColor="Gray"/>
                            <Label x:Name="BeneficiariesCount" Text="0" FontSize="26"
                                   FontAttributes="Bold" TextColor="#8B0000"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border FlexLayout.Basis="150" FlexLayout.Grow="1"
                            Margin="5" Padding="15"
                            Stroke="LightGray" StrokeThickness="1">
                        <VerticalStackLayout>
                            <Label Text="Support Sessions" FontSize="12" TextColor="Gray"/>
                            <Label x:Name="SessionsCount" Text="0" FontSize="26"
                                   FontAttributes="Bold" TextColor="#8B0000"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border FlexLayout.Basis="150" FlexLayout.Grow="1"
                            Margin="5" Padding="15"
                            Stroke="LightGray" StrokeThickness="1">
                        <VerticalStackLayout>
                            <Label Text="Awareness Events" FontSize="12" TextColor="Gray"/>
                            <Label x:Name="EventsCount" Text="0" FontSize="26"
                                   FontAttributes="Bold" TextColor="#8B0000"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border FlexLayout.Basis="150" FlexLayout.Grow="1"
                            Margin="5" Padding="15"
                            Stroke="LightGray" StrokeThickness="1">
                        <VerticalStackLayout>
                            <Label Text="Attendance Records" FontSize="12" TextColor="Gray"/>
                            <Label x:Name="AttendanceCount" Text="0" FontSize="26"
                                   FontAttributes="Bold" TextColor="#8B0000"/>
                        </VerticalStackLayout>
                    </Border>

                   

                </FlexLayout>

                <Label Text="Recent Support Sessions"
                       FontSize="20"
                       FontAttributes="Bold"
                       Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </CollectionView.Header>

        <!-- ===== Each session is a card instead of a 4-column table row ===== -->
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Margin="15,5"
                        Padding="12"
                        Stroke="LightGray"
                        StrokeThickness="1"
                        BackgroundColor="{Binding BackgroundColor}">
                    <VerticalStackLayout Spacing="4">

                        <Label Text="{Binding Beneficiary.FullName}"
                               FontAttributes="Bold"
                               FontSize="16"/>

                        <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
                            <Label Text="{Binding SupportType}"
                                   TextColor="#8B0000"/>
                            <Label Text="{Binding SessionDate, StringFormat='{0:yyyy-MM-dd}'}"
                                   TextColor="Gray"/>
                        </FlexLayout>

                        <Label Text="{Binding FollowUpNotes}"
                               FontSize="13"
                               TextColor="Gray"
                               MaxLines="2"
                               LineBreakMode="TailTruncation"/>

                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <!-- ===== Quick navigation buttons: wrap instead of running off screen ===== -->
        <CollectionView.Footer>
            <FlexLayout Wrap="Wrap" Padding="15" Margin="0,10,0,20">
                <Button Text="Beneficiaries"
                        BackgroundColor="#8B0000" TextColor="White"
                        Margin="0,0,10,10"
                        Clicked="OnBeneficiariesClicked"/>
                <Button Text="Awareness Events"
                        BackgroundColor="#8B0000" TextColor="White"
                        Margin="0,0,10,10"
                        Clicked="OnEventsClicked"/>
                <Button Text="Support Sessions"
                        BackgroundColor="#8B0000" TextColor="White"
                        Margin="0,0,10,10"
                        Clicked="OnSupportClicked"/>
            </FlexLayout>
        </CollectionView.Footer>

    </CollectionView>
</ContentPage>